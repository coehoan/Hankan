NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local integration-test administration only. Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server only: OpenAI Responses API, gpt-6-luna, reasoning.effort=high.
# Enter the real key in .env.local; never use a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=

# Web Push: generate per deployment; never commit the private key.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-real-contact@example.com

# Optional container-only connection URL; browser URL stays NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_SERVER_URL=
